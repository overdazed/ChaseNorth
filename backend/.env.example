# Environment Variables for Production

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chasenorth

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-here

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Email (for notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Company Information
COMPANY_NAME=ChaseNorth
COMPANY_EMAIL=shop@chasenorth.com
COMPANY_PHONE=+49 162 9194171
COMPANY_ADDRESS=Kantstr. 10
COMPANY_CITY=Nienburg (Weser)
COMPANY_ZIP=31582
COMPANY_COUNTRY=DE
COMPANY_VAT=TAX123456789

# Tax Rate (as percentage)
TAX_RATE=18

# Python Path (for invoice generation)
PYTHON_PATH=python

# Supabase (for file storage)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Node Environment
NODE_ENV=production
PORT=3000